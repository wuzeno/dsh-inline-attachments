{
  "name": "dsh-inline-attachments",
  "version": "0.1.3",
  "description": "让文件成为表达的一部分：为 DSH 提供句中附件引用、紧凑标签与按需图片预览。实验预览版。",
  "homepage": "https://github.com/wuzeno/dsh-inline-attachments#readme",
  "repository": { "type": "git", "url": "git+https://github.com/wuzeno/dsh-inline-attachments.git" },
  "bugs": { "url": "https://github.com/wuzeno/dsh-inline-attachments/issues" },
  "author": "wuzeno",
  "keywords": ["dsh", "deepseek-harness", "plugin", "inline-attachments", "multimodal", "user-experience"],
  "type": "commonjs",
  "license": "MIT",
  "engines": { "node": ">=22.13.0", "dsh": ">=0.2.1-rc.3 <0.3.0" },
  "exports": { ".": "./index.js", "./client": "./client.js", "./icon": "./icon.svg" },
  "files": ["index.js", "client.js", "cordis.patch.yml", "README.md", "README.en.md", "LICENSE", "CHANGELOG.md", "icon.svg", "src", "scripts", "test", "docs"],
  "scripts": { "build": "node scripts/build.cjs", "test": "node --test", "check": "node scripts/build.cjs && node --check client.js && node --test", "verify:package": "node scripts/verify-package.cjs", "check:docs": "node scripts/check-docs.cjs" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-input-trigger", "@deepseek-ai/dsh-client-ui-chat"] } }
}
